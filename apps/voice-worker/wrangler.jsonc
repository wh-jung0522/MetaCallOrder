{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callorder-voice",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "rules": [{ "type": "Data", "globs": ["**/*.pcm"], "fallthrough": false }],
  // Deletes call audio past 30 days. Logs and transcripts go by pg_cron, at the same hour.
  "triggers": { "crons": ["0 3 * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "CALL_SESSION", "class_name": "CallSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallSession"] }],
  "vars": {
    "META_LLM_MODEL": "muse-spark-1.3",
    "META_STT_MODEL": "muse-voice-transcribe-1.0",
    "META_BASE_URL": "https://api.meta.ai/v1",
    "META_STT_URL": "https://api.meta.ai/v1/asr/realtime",
    "TTS_PROVIDER": "typecast",
    "TTS_URL": "https://api.typecast.ai/v1/text-to-speech/stream",
    "TTS_MODEL": "ssfm-v31",
    "TTS_VOICE": "tc_69f2e455ea79fd197aa0476f",
    "SUPABASE_URL": "https://zxwyosusrvxxpnahdaoq.supabase.co",
    "ALLOWED_ORIGINS": "https://callorder-web.pages.dev,https://*.callorder-web.pages.dev"
  },
  "env": {
    "staging": {
      "name": "callorder-voice-staging",
      "triggers": { "crons": ["0 3 * * *"] },
      "durable_objects": {
        "bindings": [{ "name": "CALL_SESSION", "class_name": "CallSession" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallSession"] }],
      "vars": {
        "META_LLM_MODEL": "muse-spark-1.3",
        "META_STT_MODEL": "muse-voice-transcribe-1.0",
        "META_BASE_URL": "https://api.meta.ai/v1",
        "META_STT_URL": "https://api.meta.ai/v1/asr/realtime",
        "TTS_PROVIDER": "typecast",
        "TTS_URL": "https://api.typecast.ai/v1/text-to-speech/stream",
        "TTS_MODEL": "ssfm-v31",
        "TTS_VOICE": "tc_69f2e455ea79fd197aa0476f",
        "SUPABASE_URL": "https://zxwyosusrvxxpnahdaoq.supabase.co",
        "ALLOWED_ORIGINS": "https://*.callorder-web.pages.dev"
      }
    }
  }
}
